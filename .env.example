# Smart Business Data Analytics Platform — Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# The .env file is listed in .gitignore and must NEVER be committed to
# version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   streamlit run app.py
#
# python-dotenv must be installed for .env to be loaded automatically:
#   pip install python-dotenv
#
# If python-dotenv is not installed, export variables in your shell instead:
#   export LIVE_API_ENABLED=true
#   export LIVE_API_URL=https://api.example.com/transactions
# ---------------------------------------------------------------------------

# ── Live API Integration ──────────────────────────────────────────────────────

# Set to "true" to enable the live API integration.
# Any other value (or absent) keeps the feature disabled.
# Default: false
LIVE_API_ENABLED=false

# Full URL of the REST API endpoint that returns transaction records.
# The endpoint must return JSON in one of these two formats:
#
#   Format A — bare array:
#     [{"transaction_id": "T1", "order_id": "O1", ...}, ...]
#
#   Format B — wrapped object (configure LIVE_API_DATA_KEY to match):
#     {"data": [...], "next": "https://api.example.com/transactions?page=2"}
#
# Required when LIVE_API_ENABLED=true.
LIVE_API_URL=

# Bearer token for API authentication (sent as "Authorization: Bearer <token>").
# Leave blank if the API does not require authentication.
# NEVER commit a real token to version control.
LIVE_API_TOKEN=

# Request timeout in seconds (default: 30).
# Increase this value if your API is slow to respond.
LIVE_API_TIMEOUT_SECONDS=30

# The JSON key whose value is the transaction array when the API returns a
# wrapper object (Format B above).
# Default: "data"
# Example: set to "transactions" if the API returns {"transactions": [...]}
LIVE_API_DATA_KEY=data
